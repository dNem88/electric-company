---
import LayoutMain from "@/src/layouts/LayoutMain.astro";

import HeroSection from "./_components/sections/HeroSection.astro";
import SectionServices from './_components/sections/SectionServices.astro'
import SectionWhyUS from "./_components/sections/SectionWhyUS.astro";
import SectionStats from "./_components/sections/SectionStats.astro";
import SectionAbout from "./_components/sections/SectionAbout.astro";
import TeamSection from './_components/sections/TeamSection.astro'
import CTASection from "./_components/sections/CTASection.astro";
import TestimonialsSection from "./_components/sections/TestimonialsSection.astro";
import FAQSection from "./_components/sections/FAQSection.astro";

import SectionContacts from "./_components/sections/SectionContacts.astro";
---

<LayoutMain color="services1">
  <!-- <Header slot="header" /> -->
  <Fragment slot="main"> 
    <HeroSection/>
    <SectionServices/>
    <SectionStats/>
    <SectionAbout/>
    <CTASection/>
    <TestimonialsSection/>
    <SectionWhyUS/>
    <!-- <BlogSection/> -->
    <TeamSection/>
    <FAQSection/>
    <SectionContacts/>
  </Fragment>
</LayoutMain>

<style>
  :global(.services1){
  --primary-dark-1: #ffa800;
   --primary-main-1: #ffdb00;
   --primary-light-1: #fdf167;
   --primary-lighter-1: #fffde5;
    --secondary-dark-1: #050505;
    --secondary-main-1: #434343;
    --secondary-light-1: #d9d9d9;
    --secondary-lighter-1: #f5f5f5;
}
  
</style>
