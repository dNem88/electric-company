---

import MapPinIcon from "@/src/GOK_LIBRARY/icons/map-pin-icon.astro";
import CallIcon from "@/src/GOK_LIBRARY/icons/call-icon.astro";
import MailIcon from "@/src/GOK_LIBRARY/icons/mail-icon.astro";
import LayoutSideBySide from "@/src/GOK_LIBRARY/layouts-sections/layout-side-by-side.astro";
import MailForm from "./MailForm";
const mapsHref = "https://www.google.com/maps/search/?api=1&query=Google&query_place_id=ChIJveFDSaeFqkAR93wcYRrZPDk";
---



<LayoutSideBySide
  sx={{
    backgroundColor: "var(--secondary-dark-1)",
  }}
  align="center"
>
  <div class="contacts-information" slot="right">
    <a href={"/"} class="link">
      <div class="link-container">
        <MapPinIcon class="icon" />
        <p >{"адрес: гр.Варна, жк Чайка, бл 44Г"}</p>
      </div>
    </a>

    <a href={"mailto:iliya.kostadinov@abv.bg"} class="link">
      <div class="link-container">
        <MailIcon class="icon" />
        <p >{"и-мейл : iliya.kostadinov@abv.bg"}</p>
      </div>
    </a>

    <a href={"tel:+35952825555"} class="link">
      <div class="link-container">
        <CallIcon class="icon" />
        <p >{"телефон: 052 825 555"}</p>
      </div>
    </a>

    <iframe
    title="Карта с местоположението на кабинета"
      class="map-iframe"
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3464.2368580540074!2d27.939508199999995!3d43.216046999999996!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x40a45419b9970f8d%3A0xdc94783600edc602!2z0LYu0LouINCn0LDQudC60LDQn9GA0LjQvNC-0YDRgdC60LgsINC2LtC6LiDQp9Cw0LnQutCwIDQ00JMsIDkwMDUg0JLQsNGA0L3QsA!5e1!3m2!1sbg!2sbg!4v1748342555419!5m2!1sbg!2sbg"
      width="600"
      height="450"
      style={{ border: 0 }}
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
    >
    </iframe>
  </div>

  <MailForm slot='left' client:visible/>
</LayoutSideBySide>

<style>
  .contacts-information {
    z-index: 5;
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    flex-direction: column;
    width: min(100%, 520px);
  
    gap: 1rem;
    padding: 0;
  }
  /* MD Medium Devices (Tablets, 900px and up) */
  @media screen and (min-width: 900px) {
    /* Styles for medium devices */
    .contacts-information {
      padding: 2rem;
    }
  }

  /*ContactRowWithIcon*/

  /*GoogleMapsLinkContainer*/
  .link-container {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }
  .link-container :nth-child(1) {
    color: white; /* Default color for the icon */
  }

  .link-container :nth-child(2) {
    color: white; /* Default color for the text */
  }

  /* Hover styles */
  .link-container:hover,
  .link-container:hover :nth-child(2) {
    text-decoration: underline;
    color: var(--primary-main-1); /* Hover color for both icon and text */
  }
  .map-iframe {
    display: flex;
    width: min(100%, 520px);
    border: 4px solid white;
    margin-top: 3rem;
    border-radius: 12px;
  }
  .icon {
    fill: white;
    width: 24px;
    height: 24px;
  }
</style>
