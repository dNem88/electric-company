
---
import CardTestimonials3 from "@/src/GOK_LIBRARY/cards/testimonials/card-testimonials-3.astro";
import Title3 from "@/src/GOK_LIBRARY/titles/title3.astro";
import LayoutCards from "@/src/GOK_LIBRARY/layouts-sections/layout-cards.astro";

let customers = [
    {
        name: 'Никола Несторов',
        age: '35',
        city: 'София',
        avatarUrl: '/consultant1/thumbnails/avatar6.webp',
        testimonial: "Останах много доволен от извършената работа. Монтажът беше направен внимателно и професионално, а всичко беше обяснено ясно предварително. Препоръчвам СМП Електро на всеки, който търси качествени електроуслуги."
    },
    {
        name: 'Даниел Чочев',
        age: '48',
        avatarUrl: '/consultant1/thumbnails/avatar5.webp',
        city: 'Плевен',
        testimonial: "Потърсих СМП Електро за ремонт на електрическата инсталация. Получих коректно отношение и професионално изпълнение. Работата беше организирана добре, а след приключването всичко функционираше нормално."
    },
    {
        name: 'Елена Василева',
        age: '39',
        avatarUrl: '/consultant1/thumbnails/avatar7.webp',
        city: 'София',
        testimonial: "Използвах услугите на СМП Електро за монтаж на осветителни тела в жилището ми. Работата беше изпълнена старателно и с внимание към детайлите. Доволна съм от отношението и крайния резултат."
    }
];
---

---

<LayoutCards
 
  sxTitle={{ paddingLeft: "1rem" }}
>
  <Title3
  spanWord={3}
    slot="title"
     title={'Истински истории, реални резултати'}
    sx={{textAlign: 'center'}}
  />
  <Fragment slot="cards">
    {
      customers.map((x, idx) => (
        
        <CardTestimonials3
            name={x.name}
            age={x.age}
            city={x.city}
            avatarUrl={x.avatarUrl}
            testimonial={x.testimonial}
        />
      ))
    }
  </Fragment>
</LayoutCards>
