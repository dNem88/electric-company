---
import LayoutSideBySide from "@/src/GOK_LIBRARY/layouts-sections/layout-side-by-side.astro";
import Button4 from "@/src/GOK_LIBRARY/buttons/button4.astro";
import CheckCircleIconFilled from "@/src/GOK_LIBRARY/icons/check-circle-icon-filled.astro";
---

<LayoutSideBySide
  sx={{ backgroundColor: "var(--secondary-dark-1)", position: "relative" }}
>
  <div class="left-section" slot="left">
    <img
      src={"/consultant1/team10.webp"}
      loading="lazy"
      alt="why choose consultant1"
      class="image-left"
    />
  </div>

  <div class="right-section" slot="right">
    <p
      class={"h3"}
      style={{
        fontWeight: "650",
        color: "white",
      }}
    >
      Вашият надежден <span class="span">партньор</span> в бизнеса
    </p>
    <p class={"body2"} style={{ color: "white" }}>
      {
        "Работейски с нас получавате индивидуален подход към всеки клиент. С нас можете да разчитате на точност и прозрачност в счетоводството."
      }
    </p>
    <p class={"body2"} style={{ color: "white" }}>
      {
        "Работейски с нас получавате индивидуален подход към всеки клиент. С нас можете да разчитате на точност и прозрачност в счетоводството."
      }
    </p>
    <div class="list-item">
      <span class="icon">
        <CheckCircleIconFilled class="icon" />
      </span>
      <span class="text">{"Индивидуален подход"}</span>
    </div>

     <div class="list-item">
      <span class="icon">
        <CheckCircleIconFilled class="icon" />
      </span>
      <span class="text">{"Професионализъм и опит"}</span>
    </div>

     <div class="list-item">
      <span class="icon">
        <CheckCircleIconFilled class="icon" />
      </span>
      <span class="text">{"Надежност и резултати"}</span>
    </div>
   
    <Button4 content={"Научете повече"} variant={"primary"} href={"/uslugi"} />
  </div>
  <div class="polygon" slot="absolute-figure"></div>
</LayoutSideBySide>

<style>
  /*WhyUsSection of LandingOPAge*/

  .left-section {
    position: relative;
    display: flex;
    width: min(100%, 700px);
    min-height: 100%;
    flex-direction: column;
    gap: 1.5rem;
    .image-left {
      width: min(100%, 700px);
      aspect-ratio: 1 / 1;
      object-fit: cover;
      border-radius: 16px;
    }
  }
  .container-absolute {
    background-color: rgba(22, 29, 39, 0.85);
    width: 250px;
    height: 90px;
    top: 45px;
    right: -25px;
    border-radius: 8px;
    z-index: 20;
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .right-section {
    display: flex;
    width: min(100%, 600px);
    min-height: 100%;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
  }

  .span {
    font-weight: 650;
    color: var(--primary-main-1);
  }
  .services-container {
    display: flex;
    flex-direction: column;
    padding: 5rem 0;
  }
  .polygon {
    position: absolute;
    left: 0;
    top: 0;
    width: 500px;
    height: 500px;
    background-color: rgba(210, 175, 106, 0.427);
    z-index: 1;
    clip-path: polygon(0% 0%, 55% 0%, 100% 82%, 100% 85%);
  }
  @media screen and (min-width: 1200px) {
    .polygon {
      width: 50%;
      height: 100%;
      clip-path: polygon(75% 0%, 85% 0%, 45% 100%, 0% 100%);
    }
  }
   .list-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
   
  }
  .icon {
    fill: var(--primary-main-1);
    width: 24px;
    height: 24px;
  }
  .text {
    font-size: 1.1rem;
    line-height: 1.5;
    color: white;
  }
</style>
