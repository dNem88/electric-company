---
import LayoutMain from "@/src/layouts/LayoutMain.astro";
import Header from "./_components/HeaderTemplate6/Header.astro";
import InnerPagesHeroSection from "./_components/sections/InnerPagesHeroSection.astro";
import SectionContacts from "./_components/sections/SectionContacts.astro";
const mapsHref = "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d733.3238524532189!2d23.364035869639856!3d42.6762843841718!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x40aa85c4c0c2822b%3A0xee3e0356ccedbfb9!2sGeo%20Milev%2C%20ul.%20%22Kosta%20Lulchev%22%20118%D0%90%20%D0%90%2C%201113%20Sofia!5e0!3m2!1sen!2sbg!4v1792150826349!5m2!1sen!2sbg";

---

<LayoutMain color="services1">
  <Header slot="header" />
  <Fragment slot="main">
    <InnerPagesHeroSection title="Контакти" breadcrumb="начало | контакти" />
    <div class="iframe-wrapper">
      <div class="map-container">
        <iframe
          src={mapsHref}
          width="100%"
          height="100%"
          style={{ border: 0 }}
          allowfullscreen="true"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="map-iframe"
          title="Business Location"></iframe>
      </div>
    </div>

    <SectionContacts />
  </Fragment>
</LayoutMain>

<style>
      :global(.services1){
 
 --primary-dark-1: #ffa800;
   --primary-main-1: #ffdb00;
   --primary-light-1: #fdf167;
   --primary-lighter-1: #fffde5;
    --secondary-dark-1: #050505;
    --secondary-main-1: #434343;
    --secondary-light-1: #d9d9d9;
    --secondary-lighter-1: #f5f5f5;
 
}
  .iframe-wrapper {
    width: 100vw;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: 5rem;
    padding-bottom: 5rem;
    padding-left: 1rem;
    padding-right: 1rem;
  }
  .maps-section {
    width: 100vw;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 5rem 1rem;
  }
  .map-container {
    width: min(100%, 1200px);
    aspect-ratio: 1/1;
  }
  @media screen and (min-width: 1200px) {
    .map-container {
      width: min(100%, 1200px);
      aspect-ratio: 2 / 0.75;
    }
  }
</style>
