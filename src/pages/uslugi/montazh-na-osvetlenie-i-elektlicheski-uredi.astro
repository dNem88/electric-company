
---
import LayoutMain from "@/src/layouts/LayoutMain.astro";
import Header from "../_components/HeaderTemplate6/Header.astro";
import LayoutUsluga from "../_components/Layout-Usluga.astro";
import ListItem from "@/src/components/Common/list-item.astro";
---

<LayoutMain color="services1" title="Монтаж на осветление и електрически уреди - СМП Електро" description="Предлагаме професионални услуги за монтаж на осветление и електрически уреди в жилища, офиси и търговски помещения. Извършваме монтаж на полилеи, плафони, аплици, LED панели и свързване на битови електрически уреди." keywords="монтаж на осветление, монтаж на електрически уреди, полилеи, плафони, аплици, LED панели, свързване на електрически уреди">
  <Header slot="header" />

  <LayoutUsluga
    title="Монтаж на осветление и електрически уреди"
    breadcrumb="начало | услуги | монтаж на осветление и електрически уреди"
    slot="main"
  >
    <Fragment slot="content">
      <img
        src="/template6/team1.webp"
        alt="Монтаж на осветление и електрически уреди"
        loading="lazy"
        style={{
          width: "100%",
          height: "300px",
          objectFit: "cover"
        }}
      />

      <p class="body2">
        Предлагаме монтаж на осветителни тела и електрически уреди
        за жилища, офиси и търговски помещения. Независимо дали
        обзавеждате нов дом, обновявате интериора или подменяте
        съществуващо оборудване, съдействаме за правилното и безопасно
        свързване на електрическите компоненти.
      </p>

      <p class="body2">
        Извършваме монтаж на различни видове осветление, включително
        полилеи, плафони, LED панели, аплици и осветителни тела за
        кухня, баня и други помещения. Съобразяваме позицията на
        осветлението с предназначението на пространството и
        наличните електрически изводи.
      </p>

      <div>
        <ListItem iconStyle={{ fill: "red" }}>
          Монтаж на полилеи, плафони и аплици
        </ListItem>
        <ListItem iconStyle={{ fill: "red" }}>
          Монтаж на LED осветление и осветителни панели
        </ListItem>
        <ListItem iconStyle={{ fill: "red" }}>
          Монтаж и свързване на ключове и димери
        </ListItem>
        <ListItem iconStyle={{ fill: "red" }}>
          Свързване на подходящи битови електрически уреди
        </ListItem>
        <ListItem iconStyle={{ fill: "red" }}>
          Подмяна на стари осветителни тела и електрически компоненти
        </ListItem>
        <ListItem iconStyle={{ fill: "red" }}>
          Проверка на свързването и работата след монтажа
        </ListItem>
      </div>

      <p class="body2">
        Правилният монтаж е важен както за надеждната работа на
        оборудването, така и за безопасността в дома или офиса.
        При изпълнение на дейностите се съобразяваме с техническите
        изисквания на производителя, характеристиките на електрическата
        инсталация и условията на конкретния обект.
      </p>

      <p class="body2">
        При подмяна на осветление можем да съдействаме с демонтаж
        на старите тела и монтаж на новите на подходящите места.
        При необходимост от нови изводи, промяна на окабеляването
        или допълнителни електромонтажни дейности предварително
        уточняваме необходимия обхват на работата.
      </p>

      <p class="body2">
        Нуждаете се от монтаж на ново осветление или свързване на
        електрически уред? Свържете се с нас, за да обсъдим вашите
        нужди и особеностите на обекта. Ще уточним необходимите
        дейности и ще ви предложим подходящо решение за вашия дом,
        офис или търговско помещение.
      </p>
    </Fragment>
  </LayoutUsluga>
</LayoutMain>

<style>
     :global(.services1){
 
 --primary-dark-1: #ffa800;
   --primary-main-1: #ffdb00;
   --primary-light-1: #fdf167;
   --primary-lighter-1: #fffde5;
    --secondary-dark-1: #050505;
    --secondary-main-1: #434343;
    --secondary-light-1: #d9d9d9;
    --secondary-lighter-1: #f5f5f5;
  
}
</style>
