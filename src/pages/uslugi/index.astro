---
import LayoutMain from "@/src/layouts/LayoutMain.astro";
import Header from "../_components/HeaderTemplate6/Header.astro";
import InnerPagesHeroSection from '../_components/sections/InnerPagesHeroSection.astro'
import SectionProcess from "../_components/uslugi/SectionProcess.astro";
import SectionServices from "../_components/uslugi/SectionServices.astro";
import CTASection from "../_components/uslugi/CTASection.astro";

---

<LayoutMain color="services1" title="Услуги - СМП Електро" description="Предлагаме професионални електричарски услуги 24/7. Свържете се с нас за аварийни ремонти, изграждане на електроинсталации и монтаж на осветление и електрически уреди." keywords="електричар, електрически инсталации, ремонт, аварийни ремонти, изграждане на електроинсталации, монтаж на осветление и електрически уреди">
  <Header slot="header" />
  <Fragment slot="main"> 
    <InnerPagesHeroSection
        title="Услуги"
        breadcrumb="начало | услуги"
    />
        <SectionServices/>
        <CTASection/>
        <SectionProcess/>
  </Fragment>
</LayoutMain>

<style>
   :global(.services1){
  
 --primary-dark-1: #ffa800;
   --primary-main-1: #ffdb00;
   --primary-light-1: #fdf167;
   --primary-lighter-1: #fffde5;
    --secondary-dark-1: #050505;
    --secondary-main-1: #434343;
    --secondary-light-1: #d9d9d9;
    --secondary-lighter-1: #f5f5f5;
 
}
</style>
